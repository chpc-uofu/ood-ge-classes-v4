<%-
  emailcmd = '/uufs/chpc.utah.edu/sys/bin/CHPCEmailLookup.sh ' + ENV["USER"]
  emailaddr = %x[ #{emailcmd}]
  if my_job_type == "np4cpu" 
    cluster = "notchpeak"
  elsif my_job_type == "lp1gpu"
    cluster = "lonepeak"
  end
-%>

batch_connect:
  template: "basic"
cluster: "<%= cluster %>"
script:
  email: <%= emailaddr %>
  native:
    - "-N"
    - "1"
  <%- if my_job_type == "np4cpu" -%>
    - "-n"
    - 4
    - "--ntasks-per-node=4"
    - "-A"
    - "notchpeak-shared-short"
    - "-p"
    - "notchpeak-shared-short"
  <%- elsif my_job_type == "lp1gpu" -%>
    - "-n"
    - 4
    - "--ntasks-per-node=4"
    - "-A"
    - "lonepeak-gpu"
    - "-p"
    - "lonepeak-gpu"
    - "--gres=gpu:1080ti:1"
    - "--reservation=mktg6620"
  <%- end -%>
